# .env

# LLM Agent & Slash commands
LLM_CHAT_CMD="php ../agents/artisan pnc:agent:chat --input="
SKILLS_CMD="php ../agents/artisan pnc:agent:skills --pretty"

# Sidebar Control Panel commands
CMD_DEFAULT="php ../agents/artisan list"
CMD_CACHE="php ../agents/artisan cache:clear"
CMD_MIGRATE="php ../agents/artisan migrate"
CMD_MIGRATE_DRY="php ../agents/artisan migrate --pretend"
